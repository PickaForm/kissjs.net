{
    "plugins": [
        "plugins/markdown"
    ],
    "opts": {
        "encoding": "utf8",
        "destination": "out/",
        "verbose": true
    },
    "templates": {
        "better-docs": {
            "name": "KissJS api documentation"
        }
    },
    "source": {
        "include": ["../../KissJS/kissjs/"],
        "exclude": [
            "../../KissJS/kissjs/client/bundler/",
            "../../KissJS/kissjs/server/",
            "../../KissJS/kissjs/client/kissjs.js",
            "../../KissJS/kissjs/client/kissjs.min.js",
            "../../KissJS/kissjs/client/kissjs.ux.js",
            "../../KissJS/kissjs/client/kissjs.ux.min.js",
            "../../KissJS/kissjs/client/ux/"
        ]
    }
}